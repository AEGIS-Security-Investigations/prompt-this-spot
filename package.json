{
  "name": "prompt-this-spot",
  "version": "0.1.0",
  "description": "Point at a spot in a React app, capture it, and hand an AI coding agent a ready-made prompt — or file it as user feedback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AEGIS-Security-Investigations/prompt-this-spot"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.1.2",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@codemirror/view": "^6.0.0",
    "@uiw/react-codemirror": "^4.21.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@codemirror/view": "6.43.12",
    "@happy-dom/global-registrator": "^18.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
